{
  "name": "obaid-personal-website",
  "version": "1.0.0",
  "description": "Personal website built with 11ty and Tailwind CSS",
  "main": "index.js",
  "engines": {
    "node": ">=16.0.0"
  },
  "scripts": {
    "build:css": "npx tailwindcss -i ./src/styles/tailwind.css -o ./src/assets/tailwind.css --minify",
    "build:eleventy": "npx @11ty/eleventy",
    "build": "npm run build:css && npm run build:eleventy",
    "watch:css": "npx tailwindcss -i ./src/styles/tailwind.css -o ./src/assets/tailwind.css --watch",
    "watch:eleventy": "npx @11ty/eleventy --serve",
    "serve": "npm run build:css && npm run watch:eleventy",
    "start": "npm run serve",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": ["11ty", "tailwindcss", "portfolio", "website"],
  "author": "Obaid Ur Rehman",
  "license": "MIT",
  "dependencies": {
    "@11ty/eleventy": "^2.0.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.31",
    "tailwindcss": "^3.4.1"
  }
}
