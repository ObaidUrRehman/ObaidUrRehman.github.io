<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ title or "Obaid Ur Rehman" }}</title>
    <meta name="description" content="Software Engineer & AI Enthusiast building intelligent, scalable solutions">
    <link href="/assets/tailwind.css" rel="stylesheet">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Inter', sans-serif; }
        
        /* Wave Animations */
        @keyframes wave-move-1 {
            0%, 100% {
                transform: translateX(0%) translateY(0px);
            }
            50% {
                transform: translateX(-2%) translateY(-10px);
            }
        }

        @keyframes wave-move-2 {
            0%, 100% {
                transform: translateX(0%) translateY(0px);
            }
            50% {
                transform: translateX(2%) translateY(10px);
            }
        }

        @keyframes wave-move-3 {
            0%, 100% {
                transform: translateX(0%) translateY(0px);
            }
            50% {
                transform: translateX(-1%) translateY(-5px);
            }
        }

        .wave-1 {
            animation: wave-move-1 8s ease-in-out infinite;
            transform-origin: center center;
        }

        .wave-2 {
            animation: wave-move-2 6s ease-in-out infinite;
            transform-origin: center center;
        }

        .wave-3 {
            animation: wave-move-3 10s ease-in-out infinite;
            transform-origin: center center;
        }

        @keyframes wave-move-4 {
            0%, 100% {
                transform: translateX(0%) translateY(0px);
            }
            50% {
                transform: translateX(1.5%) translateY(8px);
            }
        }

        @keyframes wave-move-5 {
            0%, 100% {
                transform: translateX(0%) translateY(0px);
            }
            50% {
                transform: translateX(-1.5%) translateY(-8px);
            }
        }

        @keyframes wave-move-6 {
            0%, 100% {
                transform: translateX(0%) translateY(0px);
            }
            50% {
                transform: translateX(1%) translateY(6px);
            }
        }

        .wave-4 {
            animation: wave-move-4 7s ease-in-out infinite;
            transform-origin: center center;
        }

        .wave-5 {
            animation: wave-move-5 9s ease-in-out infinite;
            transform-origin: center center;
        }

        .wave-6 {
            animation: wave-move-6 12s ease-in-out infinite;
            transform-origin: center center;
        }

        /* Animated Logo */
        .animated-logo {
            opacity: 1;
            transition: all 0.3s ease;
        }





        /* Letter O Animation */
        .animated-logo #letter-o {
            animation: draw-circle 2s ease-out forwards;
        }

        /* Letter R Animation */
        .animated-logo #r-complete {
            animation: draw-r-complete 2s ease-out 2s forwards;
        }

        /* Hero Logo Animations */
        .animated-logo #hero-letter-o {
            animation: draw-circle 2s ease-out forwards;
        }

        .animated-logo #hero-r-complete {
            animation: draw-r-complete 2s ease-out 2s forwards;
        }

        /* Hero Logo Hover Effects */
        .animated-logo:hover #hero-letter-o,
        .animated-logo:hover #hero-r-complete {
            stroke: url(#heroLogoGradientHover);
            transition: stroke 0.3s ease;
        }

        /* Keyframes */
        @keyframes draw-circle {
            from {
                stroke-dashoffset: 62.83;
            }
            to {
                stroke-dashoffset: 0;
            }
        }

        @keyframes draw-r-complete {
            from {
                stroke-dashoffset: 70;
            }
            to {
                stroke-dashoffset: 0;
            }
        }



        /* Gradient text effect */
        .gradient-text {
            background: none;
            background-clip: unset;
            -webkit-background-clip: unset;
            -webkit-text-fill-color: unset;
            color: unset;
        }

        .dark .gradient-text {
            background: linear-gradient(135deg, #60a5fa 0%, #a855f7 50%, #ec4899 100%);
            background-clip: text;
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-size: 200% 200%;
            animation: gradient-shift 6s ease infinite;
        }

        @keyframes gradient-shift {
            0%, 100% {
                background-position: 0% 50%;
            }
            50% {
                background-position: 100% 50%;
            }
        }

        /* Floating animation for buttons */
        .floating-btn {
            animation: floating 4s ease-in-out infinite;
        }

        @keyframes floating {
            0%, 100% {
                transform: translateY(0px);
            }
            50% {
                transform: translateY(-3px);
            }
        }

                        /* Custom enhanced shadow */
        .shadow-3xl {
            box-shadow: 0 35px 60px -12px rgba(0, 0, 0, 0.25);
        }

        /* Navbar styles */
        nav {
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
        }
        
        nav a:not(.logo-link) {
            position: relative;
            transition: color 0.3s ease;
        }
        
        nav a:not(.logo-link)::after {
            content: '';
            position: absolute;
            width: 0;
            height: 2px;
            bottom: -4px;
            left: 0;
            background: linear-gradient(135deg, #3b82f6, #8b5cf6);
            transition: width 0.3s ease;
        }
        
        nav a:not(.logo-link):hover::after {
            width: 100%;
        }

        /* Theme toggle button styles */
        #theme-toggle {
            position: relative;
            z-index: 10;
        }
        
        #theme-toggle svg {
            pointer-events: none;
        }
        
        #theme-toggle:hover {
            transform: scale(1.05);
        }

        .hero-glow {
            font-weight: 800;
            background: linear-gradient(90deg, #ff6a00 0%, #ee0979 25%, #a21caf 50%, #2196f3 75%, #00c3ff 100%);
            background-size: 200% 200%;
            background-clip: text;
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            color: transparent;
            animation: hero-gradient-move 6s ease-in-out infinite;
        }
        .gradient-text {
            background: none;
            background-clip: unset;
            -webkit-background-clip: unset;
            -webkit-text-fill-color: unset;
            color: unset;
        }
        @keyframes hero-gradient-move {
            0%, 100% { background-position: 0% 50%; }
            50% { background-position: 100% 50%; }
        }

        /* Mobile Menu Animation */
        #mobile-menu {
            max-height: 0;
            overflow: hidden;
            transition: max-height 0.3s ease-in-out;
            opacity: 0;
            visibility: hidden;
        }
        
        #mobile-menu.show {
            max-height: 300px;
            opacity: 1;
            visibility: visible;
        }

        /* Mobile Menu Link Hover Effects */
        #mobile-menu a {
            position: relative;
            transition: color 0.3s ease;
        }
        
        #mobile-menu a::after {
            content: '';
            position: absolute;
            width: 0;
            height: 2px;
            bottom: 8px;
            left: 0;
            background: linear-gradient(135deg, #3b82f6, #8b5cf6);
            transition: width 0.3s ease;
        }
        
        #mobile-menu a:hover::after {
            width: 100%;
        }

 
    </style>
</head>
<body class="bg-white dark:bg-gray-950 text-gray-900 dark:text-white">
    <!-- Navigation -->
    <nav class="fixed top-0 w-full bg-white dark:bg-gray-950 border-b border-gray-200 dark:border-gray-800 px-6 py-4 z-50 transition-colors duration-300">
        <div class="max-w-7xl mx-auto flex justify-between items-center">
                <div class="text-xl font-medium">
                    <a href="/" class="logo-link hover:text-blue-600 dark:hover:text-blue-400 transition-colors cursor-pointer relative z-10">
                        <svg width="120" height="72" viewBox="0 0 100 50" xmlns="http://www.w3.org/2000/svg" class="animated-logo">
                            <defs>
                                <!-- Logo Gradient -->
                                <linearGradient id="logoGradient" x1="0%" y1="0%" x2="100%" y2="0%">
                                    <stop offset="0%" style="stop-color:#3b82f6;stop-opacity:1" />
                                    <stop offset="50%" style="stop-color:#8b5cf6;stop-opacity:1" />
                                    <stop offset="100%" style="stop-color:#ec4899;stop-opacity:1" />
                                </linearGradient>
                                <!-- Hover Gradient -->
                                <linearGradient id="logoGradientHover" x1="0%" y1="0%" x2="100%" y2="0%">
                                    <stop offset="0%" style="stop-color:#60a5fa;stop-opacity:1" />
                                    <stop offset="50%" style="stop-color:#a855f7;stop-opacity:1" />
                                    <stop offset="100%" style="stop-color:#f472b6;stop-opacity:1" />
                                </linearGradient>
                            </defs>
                            
                            <!-- Letter O -->
                            <circle id="letter-o" 
                                    cx="20" cy="25" r="10" 
                                    fill="none" 
                                    stroke="url(#logoGradient)" 
                                    stroke-width="3" 
                                    stroke-linecap="round"
                                    stroke-dasharray="62.83"
                                    stroke-dashoffset="62.83"/>
                            
                            <!-- Letter R -->
                            <g id="letter-r">
                                <!-- Complete R shape in one path -->
                                <path id="r-complete" d="M38 35 L38 15 L50 15 Q54 15 54 19 L54 21 Q54 25 50 25 L38 25 M44 25 L54 35" 
                                      fill="none" 
                                      stroke="url(#logoGradient)" 
                                      stroke-width="3" 
                                      stroke-linecap="round"
                                      stroke-linejoin="round"
                                      stroke-dasharray="70"
                                      stroke-dashoffset="70"/>
                            </g>
                        </svg>
                    </a>
                </div>
                <div class="flex items-center space-x-8">
                    <!-- Desktop Navigation - Hidden on mobile -->
                    <div class="hidden md:flex space-x-8">
                        <a href="#about" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors cursor-pointer">About</a>
                        <a href="#experience" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors cursor-pointer">Experience</a>
                        <a href="#projects" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors cursor-pointer">Projects</a>
                        <a href="#contact" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors cursor-pointer">Contact</a>
                    </div>

                    <!-- Mobile Menu Button - Visible on mobile -->
                    <button id="mobile-menu-toggle" class="md:hidden p-2 rounded-lg bg-gray-100 dark:bg-gray-800 hover:bg-gray-200 dark:hover:bg-gray-700 transition-all duration-300 cursor-pointer">
                        <svg class="w-6 h-6 text-gray-600 dark:text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
                        </svg>
                    </button>
                    
                    <!-- Dark Mode Toggle - Always visible -->
                    <button id="theme-toggle" class="p-2 rounded-lg bg-gray-100 dark:bg-gray-800 hover:bg-gray-200 dark:hover:bg-gray-700 transition-all duration-300 cursor-pointer">
                        <div class="relative w-6 h-6">
                            <!-- Sun Icon -->
                            <svg id="sun-icon" class="absolute inset-0 w-6 h-6 text-yellow-500 transition-all duration-300 transform rotate-0 scale-100 dark:rotate-90 dark:scale-0 pointer-events-none" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
                            </svg>
                            <!-- Moon Icon -->
                            <svg id="moon-icon" class="absolute inset-0 w-6 h-6 text-blue-500 transition-all duration-300 transform rotate-90 scale-0 dark:rotate-0 dark:scale-100 pointer-events-none" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
                            </svg>
                        </div>
                    </button>
                </div>
            </div>
        </div>

        <!-- Mobile Navigation Menu - Hidden -->
        <div id="mobile-menu" class="bg-white/95 dark:bg-gray-950/95 backdrop-blur-md border-t border-gray-200 dark:border-gray-800 shadow-lg">
            <div class="px-6 py-6 space-y-6 text-center">
                <a href="#about" class="block text-lg font-medium hover:text-blue-600 dark:hover:text-blue-400 transition-colors cursor-pointer py-3 border-b border-gray-100 dark:border-gray-800 transform transition-all duration-300 hover:translate-x-2">About</a>
                <a href="#experience" class="block text-lg font-medium hover:text-blue-600 dark:hover:text-blue-400 transition-colors cursor-pointer py-3 border-b border-gray-100 dark:border-gray-800 transform transition-all duration-300 hover:translate-x-2">Experience</a>
                <a href="#projects" class="block text-lg font-medium hover:text-blue-600 dark:hover:text-blue-400 transition-colors cursor-pointer py-3 border-b border-gray-100 dark:border-gray-800 transform transition-all duration-300 hover:translate-x-2">Projects</a>
                <a href="#contact" class="block text-lg font-medium hover:text-blue-600 dark:hover:text-blue-400 transition-colors cursor-pointer py-3 transform transition-all duration-300 hover:translate-x-2">Contact</a>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <div>
        {{ content | safe }}
    </div>

    <!-- Footer -->
    <footer class="py-12 border-t border-gray-200 dark:border-gray-800">
        <div class="container mx-auto px-6 md:px-12 lg:px-20 xl:px-32">
            <div class="flex flex-col md:flex-row justify-between items-center">
                <div class="mb-4 md:mb-0">
                    <p class="text-gray-600 dark:text-gray-400">© 2025 Obaid Ur Rehman. Built with 11ty & Tailwind CSS.</p>
                </div>
                <div class="flex space-x-6">
                    <a href="https://www.linkedin.com/in/obaid-urrehman/" target="_blank" class="text-gray-600 dark:text-gray-400 hover:text-blue-600 dark:hover:text-blue-400 transition-colors">
                        <span class="sr-only">LinkedIn</span>
                        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
                            <path fill-rule="evenodd" d="M16.338 16.338H13.67V12.16c0-.995-.017-2.277-1.387-2.277-1.39 0-1.601 1.086-1.601 2.207v4.248H8.014v-8.59h2.559v1.174h.037c.356-.675 1.227-1.387 2.526-1.387 2.703 0 3.203 1.778 3.203 4.092v4.711zM5.005 6.575a1.548 1.548 0 11-.003-3.096 1.548 1.548 0 01.003 3.096zm-1.337 9.763H6.34v-8.59H3.667v8.59zM17.668 1H2.328C1.595 1 1 1.581 1 2.298v15.403C1 18.418 1.595 19 2.328 19h15.34c.734 0 1.332-.582 1.332-1.299V2.298C19 1.581 18.402 1 17.668 1z" clip-rule="evenodd" />
                        </svg>
                    </a>
                    <a href="https://github.com" target="_blank" class="text-gray-600 dark:text-gray-400 hover:text-blue-600 dark:hover:text-blue-400 transition-colors">
                        <span class="sr-only">GitHub</span>
                        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
                            <path fill-rule="evenodd" d="M10 0C4.477 0 0 4.484 0 10.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0110 4.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.203 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.942.359.31.678.921.678 1.856 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0020 10.017C20 4.484 15.522 0 10 0z" clip-rule="evenodd" />
                        </svg>
                    </a>
                </div>
            </div>
        </div>
    </footer>

    <script>
        // All functionality wrapped in DOMContentLoaded
        document.addEventListener('DOMContentLoaded', function() {
            console.log('DOM loaded, initializing...');
            
            // Dark mode toggle functionality
            const themeToggle = document.getElementById('theme-toggle');
            const html = document.documentElement;
            
            console.log('Theme toggle element:', themeToggle);
            
            if (!themeToggle) {
                console.error('Theme toggle button not found!');
                return;
            }
            
            // Check for saved theme preference or default to 'dark'
            const currentTheme = localStorage.getItem('theme') || 'dark';
            console.log('Current theme from localStorage:', currentTheme);
            
            if (currentTheme === 'dark') {
                html.classList.add('dark');
                console.log('Applied dark theme');
            }
            
            // Add multiple event listeners to ensure it works
            themeToggle.addEventListener('click', function(e) {
                console.log('Theme toggle clicked!');
                e.preventDefault();
                e.stopPropagation();
                
                // Add visual feedback
                themeToggle.style.transform = 'scale(0.95)';
                setTimeout(() => {
                    themeToggle.style.transform = '';
                }, 150);
                
                html.classList.toggle('dark');
                
                // Save theme preference
                const isDark = html.classList.contains('dark');
                localStorage.setItem('theme', isDark ? 'dark' : 'light');
                console.log('Theme saved:', isDark ? 'dark' : 'light');
            });
            
            // Also add mousedown event as backup
            themeToggle.addEventListener('mousedown', function(e) {
                console.log('Theme toggle mousedown!');
            });
            
            // Mobile menu toggle functionality
            const mobileMenuToggle = document.getElementById('mobile-menu-toggle');
            const mobileMenu = document.getElementById('mobile-menu');
            
            if (mobileMenuToggle && mobileMenu) {
                mobileMenuToggle.addEventListener('click', (e) => {
                    e.preventDefault();
                    e.stopPropagation();
                    
                    // Toggle the menu with animation
                    if (mobileMenu.classList.contains('show')) {
                        // Close menu
                        mobileMenu.classList.remove('show');
                    } else {
                        // Open menu
                        mobileMenu.classList.add('show');
                    }
                });

                // Close mobile menu when clicking on a link
                document.querySelectorAll('#mobile-menu a').forEach(link => {
                    link.addEventListener('click', () => {
                        mobileMenu.classList.remove('show');
                    });
                });
            }

            // Smooth scrolling for navigation links
            document.querySelectorAll('a[href^="#"]').forEach(anchor => {
                anchor.addEventListener('click', function (e) {
                    e.preventDefault();
                    const target = document.querySelector(this.getAttribute('href'));
                    if (target) {
                        target.scrollIntoView({
                            behavior: 'smooth',
                            block: 'start'
                        });
                    }
                });
            });
            
            console.log('All event listeners attached successfully');
        });
    </script>
</body>
</html> 