    <style>
        body { font-family: 'Inter', sans-serif; }
        
        /* Wave Animations */
        @keyframes wave-move-1 {
            0%, 100% {
                transform: translateX(0%) translateY(0px);
            }
            50% {
                transform: translateX(-2%) translateY(-10px);
            }
        }

        @keyframes wave-move-2 {
            0%, 100% {
                transform: translateX(0%) translateY(0px);
            }
            50% {
                transform: translateX(2%) translateY(10px);
            }
        }

        @keyframes wave-move-3 {
            0%, 100% {
                transform: translateX(0%) translateY(0px);
            }
            50% {
                transform: translateX(-1%) translateY(-5px);
            }
        }

        .wave-1 {
            animation: wave-move-1 8s ease-in-out infinite;
            transform-origin: center center;
        }

        .wave-2 {
            animation: wave-move-2 6s ease-in-out infinite;
            transform-origin: center center;
        }

        .wave-3 {
            animation: wave-move-3 10s ease-in-out infinite;
            transform-origin: center center;
        }

        @keyframes wave-move-4 {
            0%, 100% {
                transform: translateX(0%) translateY(0px);
            }
            50% {
                transform: translateX(1.5%) translateY(8px);
            }
        }

        @keyframes wave-move-5 {
            0%, 100% {
                transform: translateX(0%) translateY(0px);
            }
            50% {
                transform: translateX(-1.5%) translateY(-8px);
            }
        }

        @keyframes wave-move-6 {
            0%, 100% {
                transform: translateX(0%) translateY(0px);
            }
            50% {
                transform: translateX(1%) translateY(6px);
            }
        }

        .wave-4 {
            animation: wave-move-4 7s ease-in-out infinite;
            transform-origin: center center;
        }

        .wave-5 {
            animation: wave-move-5 9s ease-in-out infinite;
            transform-origin: center center;
        }

        .wave-6 {
            animation: wave-move-6 12s ease-in-out infinite;
            transform-origin: center center;
        }

        /* Animated Logo */
        .animated-logo {
            opacity: 1;
            transition: all 0.3s ease;
        }





        /* Letter O Animation */
        .animated-logo #letter-o {
            animation: draw-circle 2s ease-out forwards;
        }

        /* Letter R Animation */
        .animated-logo #r-complete {
            animation: draw-r-complete 2s ease-out 2s forwards;
        }

        /* Hero Logo Animations */
        .animated-logo #hero-letter-o {
            animation: draw-circle 2s ease-out forwards;
        }

        .animated-logo #hero-r-complete {
            animation: draw-r-complete 2s ease-out 2s forwards;
        }

        /* Hero Logo Hover Effects */
        .animated-logo:hover #hero-letter-o,
        .animated-logo:hover #hero-r-complete {
            stroke: url(#heroLogoGradientHover);
            transition: stroke 0.3s ease;
        }

        /* Keyframes */
        @keyframes draw-circle {
            from {
                stroke-dashoffset: 62.83;
            }
            to {
                stroke-dashoffset: 0;
            }
        }

        @keyframes draw-r-complete {
            from {
                stroke-dashoffset: 70;
            }
            to {
                stroke-dashoffset: 0;
            }
        }



        /* Gradient text effect */
        .gradient-text {
            background: none;
            background-clip: unset;
            -webkit-background-clip: unset;
            -webkit-text-fill-color: unset;
            color: unset;
        }

        .dark .gradient-text {
            background: linear-gradient(135deg, #60a5fa 0%, #a855f7 50%, #ec4899 100%);
            background-clip: text;
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-size: 200% 200%;
            animation: gradient-shift 6s ease infinite;
        }

        @keyframes gradient-shift {
            0%, 100% {
                background-position: 0% 50%;
            }
            50% {
                background-position: 100% 50%;
            }
        }

        /* Floating animation for buttons */
        .floating-btn {
            animation: floating 4s ease-in-out infinite;
        }

        @keyframes floating {
            0%, 100% {
                transform: translateY(0px);
            }
            50% {
                transform: translateY(-3px);
            }
        }

                        /* Custom enhanced shadow */
        .shadow-3xl {
            box-shadow: 0 35px 60px -12px rgba(0, 0, 0, 0.25);
        }

        /* Navbar styles */
        nav {
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
        }
        
        nav a:not(.logo-link) {
            position: relative;
            transition: color 0.3s ease;
        }
        
        nav a:not(.logo-link)::after {
            content: '';
            position: absolute;
            width: 0;
            height: 2px;
            bottom: -4px;
            left: 0;
            background: linear-gradient(135deg, #3b82f6, #8b5cf6);
            transition: width 0.3s ease;
        }
        
        nav a:not(.logo-link):hover::after {
            width: 100%;
        }

        /* Theme toggle button styles */
        #theme-toggle {
            position: relative;
            z-index: 10;
        }
        
        #theme-toggle svg {
            pointer-events: none;
        }
        
        #theme-toggle:hover {
            transform: scale(1.05);
        }

        .hero-glow {
            font-weight: 800;
            background: linear-gradient(90deg, #ff6a00 0%, #ee0979 25%, #a21caf 50%, #2196f3 75%, #00c3ff 100%);
            background-size: 200% 200%;
            background-clip: text;
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            color: transparent;
            animation: hero-gradient-move 6s ease-in-out infinite;
        }
        .gradient-text {
            background: none;
            background-clip: unset;
            -webkit-background-clip: unset;
            -webkit-text-fill-color: unset;
            color: unset;
        }
        @keyframes hero-gradient-move {
            0%, 100% { background-position: 0% 50%; }
            50% { background-position: 100% 50%; }
        }

        /* Mobile Menu Animation */
        #mobile-menu {
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            background: rgba(255, 255, 255, 0.98);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            z-index: 40;
            display: flex;
            align-items: center;
            justify-content: center;
            opacity: 0;
            visibility: hidden;
            transition: all 0.3s ease-in-out;
            transform: translateY(-20px);
        }
        
        .dark #mobile-menu {
            background: rgba(17, 24, 39, 0.98);
        }
        
        #mobile-menu.show {
            opacity: 1;
            visibility: visible;
            transform: translateY(0);
        }

        /* Mobile Menu Link Hover Effects */
        #mobile-menu a {
            position: relative;
            transition: color 0.3s ease;
        }
        
        #mobile-menu a::after {
            content: '';
            position: absolute;
            width: 0;
            height: 2px;
            bottom: 8px;
            left: 0;
            background: linear-gradient(135deg, #3b82f6, #8b5cf6);
            transition: width 0.3s ease;
        }
        
        #mobile-menu a:hover::after {
            width: 100%;
        }

        /* Mouse hover effect */
        .cursor-trail {
            position: fixed;
            width: 200px;
            height: 200px;
            background: radial-gradient(circle, rgba(59, 130, 246, 0.08) 0%, rgba(139, 92, 246, 0.05) 40%, rgba(236, 72, 153, 0.03) 70%, transparent 100%);
            border-radius: 50%;
            pointer-events: none;
            z-index: 9999;
            opacity: 0.4;
            transition: all 0.2s ease;
            mix-blend-mode: screen;
            filter: blur(8px);
            box-shadow: 0 0 40px rgba(59, 130, 246, 0.2), 0 0 80px rgba(139, 92, 246, 0.1);
        }
        
        .cursor-trail.hover {
            transform: scale(1.1);
            opacity: 0.6;
            filter: blur(12px);
            box-shadow: 0 0 60px rgba(59, 130, 246, 0.3), 0 0 120px rgba(139, 92, 246, 0.2), 0 0 160px rgba(236, 72, 153, 0.1);
        }
        
        /* Hide cursor trail on mobile */
        @media (max-width: 768px) {
            .cursor-trail {
                display: none;
            }
        }

        /* Large gradient background effect */
        body::before {
            content: '';
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: radial-gradient(ellipse at center, rgba(59, 130, 246, 0.1) 0%, rgba(139, 92, 246, 0.05) 25%, rgba(236, 72, 153, 0.03) 50%, transparent 70%);
            pointer-events: none;
            z-index: -1;
        }
        
        .dark body::before {
            background: radial-gradient(ellipse at center, rgba(59, 130, 246, 0.15) 0%, rgba(139, 92, 246, 0.08) 25%, rgba(236, 72, 153, 0.05) 50%, transparent 70%);
        }

 
    </style>
</head>
